# Django runtime
DJANGO_ENV=production
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=your-domain.com,www.your-domain.com,server-ip

# Reverse proxy / SSL
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_HTTPONLY=1
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0

# Same-domain Nginx deployment: leave CORS empty and set CSRF to your HTTPS domains.
# Separate frontend domain: set DJANGO_CORS_ALLOWED_ORIGINS to that domain as well.
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com
DJANGO_CORS_ALLOW_CREDENTIALS=1

# Optional API docs in production
DJANGO_ENABLE_API_DOCS=0

# JWT tuning
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=0

# Database
# For SQLite:
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
#
# For PostgreSQL (example):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=stockanalysis
# DB_USER=stockanalysis_user
# DB_PASSWORD=replace-me
# DB_HOST=127.0.0.1
# DB_PORT=5432
